{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "memberships": {
        "ClusterId": "users-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/memberships/{**catch-all}"
        }
      },
      "companies": {
        "ClusterId": "companies-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/companies/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "templates": {
        "ClusterId": "notifications-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/templates/{**catch-all}"
        }
      },
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": -10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        }
      },
      "login": {
        "ClusterId": "users-api",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/users/Login/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "register": {
        "ClusterId": "users-api",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/users/Register/register",
          "Methods": [
            "POST"
          ]
        }
      },
      "company-structure": {
        "ClusterId": "companies-api",
        "Order": 10,
        "AuthorizationPolicy": "platform",
        "Match": {
          "Path": "/api/company-structure/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-api": {
        "Destinations": {
          "primary": {
            "Address": "http://users-api"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:35"
        }
      },
      "companies-api": {
        "Destinations": {
          "primary": {
            "Address": "http://companies-api"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:35"
        }
      },
      "notifications-api": {
        "Destinations": {
          "primary": {
            "Address": "http://notifications-api"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:35"
        }
      },
      "aggregator": {
        "Destinations": {
          "primary": {
            "Address": "http://aggregator"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:35"
        }
      }
    }
  }
}
